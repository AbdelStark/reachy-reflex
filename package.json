{
  "name": "reachy-reflex",
  "version": "0.0.1",
  "description": "Realtime social attention and turn-taking for Reachy Mini",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "vite build",
    "build:core": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "vite --host 127.0.0.1",
    "relay": "node server/main.mjs",
    "test": "npm run build:core && node --test test/*.test.mjs",
    "test:e2e": "playwright test",
    "replay:scenes": "npm run build:core && node scripts/replay_scenes.mjs fixtures/replay_scenes.jsonl",
    "replay:trace": "npm run build:core && node scripts/replay_trace.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "@pollen-robotics/reachy-mini-sdk": "1.8.0",
    "@typesafe-ai/sdk": "0.6.0",
    "reachy-jev": "git+https://github.com/AbdelStark/reachy-jev.git#b0d03cb28579127c6c643ae5f9a3c4c896224b57",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "typescript": "^5.9.0",
    "vite": "7.3.6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AbdelStark/reachy-reflex.git"
  }
}
